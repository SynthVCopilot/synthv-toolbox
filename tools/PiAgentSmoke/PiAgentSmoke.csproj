<Project Sdk="Microsoft.NET.Sdk">

  <!-- 无 GUI 冒烟测试：验证 pi_agent.dll (Rust) 的 C-ABI 契约与 P/Invoke 编组。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PiAgentDir>$(MSBuildProjectDirectory)\..\..\external\pi-agent</PiAgentDir>
  </PropertyGroup>

  <Target Name="BuildPiAgentDll" BeforeTargets="Build">
    <Exec Command="cargo build --release -p pi-agent-ffi" WorkingDirectory="$(PiAgentDir)" />
    <Copy SourceFiles="$(PiAgentDir)\target\release\pi_agent.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
