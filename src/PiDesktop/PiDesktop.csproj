<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pi Desktop：WinUI 3 / Windows App SDK 桌面壳。
    通过 P/Invoke 调用 pi-agent（Rust）编出的 C-ABI 原生 DLL「pi_agent.dll」，
    在同进程内驱动 v3 agent —— 满足「原生 WinUI 3 内部通信」。
    pi-agent 作为 git submodule 位于 external/pi-agent。
    未打包(unpackaged) 运行：WindowsPackageType=None。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PiDesktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PiAgentDir>$(MSBuildProjectDirectory)\..\..\external\pi-agent</PiAgentDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <!--
    构建 pi-agent 的 Rust DLL 并拷进输出目录。需要 Rust 工具链（cargo）在 PATH。
    首次会拉 crates，稍慢；之后增量很快。
  -->
  <Target Name="BuildPiAgentDll" BeforeTargets="Build">
    <Exec Command="cargo build --release -p pi-agent-ffi" WorkingDirectory="$(PiAgentDir)" />
    <Copy SourceFiles="$(PiAgentDir)\target\release\pi_agent.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(PiAgentDir)\target\release\pi_agent.dll')" />
  </Target>

</Project>
