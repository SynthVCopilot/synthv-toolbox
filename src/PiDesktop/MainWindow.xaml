<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PiDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Pi Agent">

    <Grid>
        <muxc:NavigationView
            x:Name="Nav"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="对话" Tag="chat" Icon="Message" />
                <muxc:NavigationViewItem Content="历史" Tag="history" Icon="Clock" />
                <muxc:NavigationViewItem Content="配置 Agent" Tag="config" Icon="Setting" />
                <muxc:NavigationViewItem Content="组件" Tag="components" Icon="Download" />
            </muxc:NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>
