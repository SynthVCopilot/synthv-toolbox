<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PiDesktop.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="历史会话" Style="{ThemeResource TitleTextBlockStyle}" />
        <ListView x:Name="ConversationsList" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="4">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Text="{Binding UpdatedAt}" Opacity="0.6" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
