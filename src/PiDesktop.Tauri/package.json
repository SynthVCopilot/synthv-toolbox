{
  "name": "synthv-toolbox",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:bridge": "node scripts/ensure-bridge.mjs",
    "build:protocol": "tsc -p ../../packages/runtime-protocol/tsconfig.json",
    "predev": "npm run build:bridge && npm run build:protocol",
    "prebuild": "npm run build:bridge && npm run build:protocol",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run build:renderer",
    "build:renderer": "tsc && vite build",
    "build:host": "npm run build:bridge && node scripts/ensure-agent-runtime.mjs && node scripts/ensure-audio-capture.mjs && tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json && node scripts/prepare-preload.mjs && node scripts/prepare-electron-assets.mjs",
    "build:electron": "node scripts/ensure-agent-runtime.mjs && npm run build:renderer && npm run build:host",
    "electron:dev": "npm run build:electron && electron . --dev-server-url=http://127.0.0.1:1420",
    "electron:start": "npm run build:electron && electron .",
    "preview": "vite preview",
    "test:contract": "node scripts/run-tests.mjs ../../test/contract",
    "test:flow": "node scripts/run-tests.mjs ../../test/flow",
    "test": "node scripts/run-tests.mjs ../../test/contract ../../test/flow"
  },
  "dependencies": {
    "@model-auth/core": "https://github.com/lsy-404/platform-kit/releases/download/model-auth-core-v0.11.1/model-auth-core-0.11.1.tgz",
    "@model-auth/providers": "https://github.com/lsy-404/platform-kit/releases/download/model-auth-providers-v0.20.0/model-auth-providers-0.20.0.tgz",
    "@model-auth/vue": "https://github.com/lsy-404/platform-kit/releases/download/model-auth-vue-v0.14.0/model-auth-vue-0.14.0.tgz",
    "@platform-kit/fluent": "https://github.com/lsy-404/platform-kit/releases/download/fluent-v0.2.11/platform-kit-fluent-0.2.11.tgz",
    "@synthv-toolbox/agent-runtime": "file:../../packages/agent-runtime",
    "@synthv-toolbox/runtime-protocol": "file:../../packages/runtime-protocol",
    "electron-updater": "^6.8.11",
    "lucide": "1.61.0",
    "pinyin-pro": "3.29.5",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "fast-check": "^4.10.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
